<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_sky_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/widget_cal_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/cd_forget_me_not"
            android:src="@drawable/ic_widget_flower" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_cal_month_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="November 2026"
                android:textColor="#2B4360"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_cal_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Forget-Me-Not Calendar"
                android:textColor="#6B85A3"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_cal_add_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_pill_deep_blue"
            android:contentDescription="@string/widget_cd_add_event"
            android:padding="6dp"
            android:src="@drawable/ic_widget_add" />
    </LinearLayout>

    <!-- Canvas-rendered Forget-Me-Not Month Grid -->
    <LinearLayout
        android:id="@+id/widget_cal_grid_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/widget_row_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:id="@+id/widget_cal_grid_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@string/widget_calendar_name"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- Today's Highlights Footer -->
    <LinearLayout
        android:id="@+id/widget_cal_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_row_card"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/widget_cal_today_line1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Today · Tap to view your plans and events"
            android:textColor="#2B4360"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_cal_today_line2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Dots mark scheduled days · Flowers mark completed habits"
            android:textColor="#6B85A3"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
