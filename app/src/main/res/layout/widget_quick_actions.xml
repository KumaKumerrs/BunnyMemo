<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_sky_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/widget_quick_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/cd_forget_me_not"
            android:src="@drawable/ic_widget_flower" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Bunny Memo"
            android:textColor="#2B4360"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_quick_streak_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_sage"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp"
            android:text="0d bloom"
            android:textColor="#35917A"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 7-Day Forget-Me-Not Habit Bloom Strip -->
    <LinearLayout
        android:id="@+id/widget_quick_habit_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_row_card"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/widget_quick_habit_image"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/habit_tracker_title"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/widget_quick_latest_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tap Quick Note to capture a spontaneous thought"
            android:textColor="#6B85A3"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Quick Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Quick Note Pill -->
        <LinearLayout
            android:id="@+id/widget_quick_btn_note"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.35"
            android:background="@drawable/widget_pill_pollen"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_quick_note" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Quick Note"
                android:textColor="#2B4360"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Add Task Pill -->
        <LinearLayout
            android:id="@+id/widget_quick_btn_add"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill_deep_blue"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_add" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Task"
                android:textColor="#FCFEFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Calendar Shortcut -->
        <ImageView
            android:id="@+id/widget_quick_btn_calendar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_row_card"
            android:contentDescription="@string/nav_calendar"
            android:padding="8dp"
            android:src="@drawable/ic_widget_calendar" />

        <!-- Classes Shortcut -->
        <ImageView
            android:id="@+id/widget_quick_btn_classes"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_row_card"
            android:contentDescription="@string/nav_classes"
            android:padding="8dp"
            android:src="@drawable/ic_widget_school" />
    </LinearLayout>
</LinearLayout>
