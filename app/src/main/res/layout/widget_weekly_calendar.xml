<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_sky_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/widget_week_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/cd_forget_me_not"
            android:src="@drawable/ic_widget_flower" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_week_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="This Week"
                android:textColor="#2B4360"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_week_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Current 7-day strip"
                android:textColor="#6B85A3"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_week_add_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_pill_deep_blue"
            android:contentDescription="@string/widget_cd_add_event"
            android:padding="6dp"
            android:src="@drawable/ic_widget_add" />
    </LinearLayout>

    <!-- Canvas-rendered Current Week 7-Day Strip ONLY -->
    <LinearLayout
        android:id="@+id/widget_week_strip_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_row_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:id="@+id/widget_week_strip_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@string/widget_weekly_name"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- Concise Today Summary Line -->
    <TextView
        android:id="@+id/widget_week_footer_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Tap to view this week's tasks and events"
        android:textColor="#2B4360"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
