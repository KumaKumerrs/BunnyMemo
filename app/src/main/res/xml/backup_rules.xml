<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for API < 31.
   Excludes private local Room database, user photos/voice memos, and account-scoped
   or auth/sync preferences so sensitive planner data is never silently exported outside
   explicit Firebase Cloud Sync.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="planner_photos" />
    <exclude domain="file" path="task_audio_memos" />
    <exclude domain="sharedpref" path="bunny_shared_calendar_seen_v1.xml" />
    <exclude domain="sharedpref" path="bunny_memo_focus_session_v1.xml" />
    <exclude domain="sharedpref" path="bunny_memo_reminders_v1.xml" />
    <exclude domain="sharedpref" path="bunny_memo_app_mode_v1.xml" />
    <exclude domain="sharedpref" path="com.google.firebase.auth.api.Store.xml" />
</full-backup-content>
