<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for API 31+.
   Excludes private Room databases, device-only media, and account/sync preferences
   from cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="planner_photos" />
        <exclude domain="file" path="task_audio_memos" />
        <exclude domain="sharedpref" path="bunny_shared_calendar_seen_v1.xml" />
        <exclude domain="sharedpref" path="bunny_memo_focus_session_v1.xml" />
        <exclude domain="sharedpref" path="bunny_memo_reminders_v1.xml" />
        <exclude domain="sharedpref" path="bunny_memo_app_mode_v1.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="planner_photos" />
        <exclude domain="file" path="task_audio_memos" />
        <exclude domain="sharedpref" path="bunny_shared_calendar_seen_v1.xml" />
        <exclude domain="sharedpref" path="bunny_memo_app_mode_v1.xml" />
    </device-transfer>
</data-extraction-rules>
